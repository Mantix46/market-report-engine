# === Market Report Mailer - Configuration ===
# Skopiuj ten plik jako .env i uzupełnij swoje dane.

# --- Email Sender (SMTP) ---
# Dla Gmail: włącz "App Passwords" w ustawieniach konta Google
# (https://myaccount.google.com/apppasswords)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Dla Outlook/Hotmail:
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj_email@gmail.com
SMTP_PASSWORD=twoje_app_password

# --- Recipient ---
RECIPIENT_EMAIL=twoj_email@gmail.com

# --- Schedule ---
# Godzina wysyłki raportu (format HH:MM, czas lokalny)
REPORT_TIME=07:30

# --- AI API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here

# Opcjonalnie: model Gemini (domyślnie gemini-3.8-flash).
# Gdy 3.8 nie zwróci tekstu, po 60 s od startu próby idzie gemini-3.5-flash,
# a na końcu krótka próba gemini-3.7-flash. Puste GEMINI_MODEL zostawia tę kolejność.
GEMINI_MODEL=gemini-3.8-flash

# --- Optional market data enrichments ---
# Kalendarz makro (publikacje US: CPI, PPI, payrolls, PCE, GDP, retail sales) z FRED.
# Darmowy klucz: https://fred.stlouisfed.org/docs/api/api_key.html
# Bez klucza kalendarz pokazuje tylko posiedzenia FOMC/RPP ze stałego harmonogramu.
FRED_API_KEY=your_fred_api_key_here

# Kontekst transkryptów earnings call przez Financial Modeling Prep (opcjonalny).
# Uwaga: kalendarz makro FMP wymaga płatnego planu — nie jest już używany.
FMP_API_KEY=your_financial_modeling_prep_api_key_here
